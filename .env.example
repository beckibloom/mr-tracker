# Copy to .env (git-ignored). The server loads it on start.

# Required: GitLab personal access token with the read_api scope.
GITLAB_TOKEN=
# GITLAB_BASE_URL=https://gitlab.com

# Which MRs count as yours: created_by_me (default), assigned_to_me, or both.
# Remote agents author MRs under their own account and usually assign them to
# you, so agent-driven workflows want assigned_to_me or both.
# MRT_MR_SCOPE=created_by_me

# Review bots: their threads never count as human feedback, and their review
# comments drive the agent chip. Access-token users (project_123_bot_...) and
# *-bot names are always treated as bots.
# MRT_BOT_USERS=review-bot,another-bot

# When the background poller runs (hours in MRT_TIMEZONE, default: system
# timezone). Refresh works any time.
# MRT_TIMEZONE=Europe/Berlin
# MRT_POLL_HOURS=9-17
# MRT_PORT=4178

# Short project names on link chips, as project-name=ABBR pairs. Unknown
# projects fall back to their initials.
# MRT_PROJECT_ABBR=my-frontend=FE,design-system=DS,e2e-tests=QA

# Optional: Jira. JIRA_BASE_URL alone enables ticket links on cards. Email and
# token add the Time tab's worklog writes, ticket summaries, and live
# membership for the focused-epic highlight.
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Optional: highlight the epic you're most focused on (badge + purple border).
# Membership comes from Jira (parent = key) when credentials are set; branch
# patterns (a regex) and labels widen the match. An empty key disables it.
# FOCUSED_EPIC_KEY=PROJ-100
# FOCUSED_EPIC_LABEL=FOCUS
# FOCUSED_EPIC_BRANCH_PATTERNS=migration-|\bepic\b
# FOCUSED_EPIC_LABELS=migration,follow-up

# Extra flags for Claude sessions started from a card (claude --bg ...).
# Sessions otherwise inherit ~/.claude/settings.json: model, permissions
# defaultMode, effort. Example: pin the model and auto-approve safe actions.
# MRT_CLAUDE_ARGS=--model fable --permission-mode auto

# Time tab: where your local repos live and which git author is you.
# MRT_DEV_ROOT=~/dev
# MRT_GIT_AUTHOR=you@example.com
